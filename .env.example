VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ──────────────────────────────────────────────────────────────────────
# RESEND_API_KEY must NOT go here — it would be exposed in the browser!
# It is a server-side secret set inside Supabase Edge Functions only.
#
# After creating your Supabase project, run this command ONE TIME:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#
# Then deploy the edge function:
#   supabase functions deploy send-score --no-verify-jwt
# ──────────────────────────────────────────────────────────────────────
